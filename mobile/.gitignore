# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
# Trellis: mobile/.env holds the release signing key (docs/mobile.md §9). Expo's template
# only ignores .env*.local, because Expo expects .env to be committed; ours is a secret.
.env

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
/android

# Trellis: generated from code, never committed (docs/mobile.md §6, §9)
/assets/generated/
/release/
*.keystore
