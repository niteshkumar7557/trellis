NEXT_PUBLIC_API_URL=http://localhost:8000
# Where "Forgot your password? Email the admin" points (the login page). Optional: without
# it the line still explains what to do, just without a mail link.
NEXT_PUBLIC_ADMIN_EMAIL=
# "on" shows "Continue with Google". Only once the backend has GOOGLE_CLIENT_ID and
# GOOGLE_CLIENT_SECRET (docs/backend-design.md §4, "Sign in with Google").
NEXT_PUBLIC_GOOGLE_SIGNIN=
