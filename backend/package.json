{
  "name": "trellis",
  "version": "0.0.1",
  "private": true,
  "description": "Trellis",
  "main": "dist/index.js",
  "scripts": {
    "db:migrate": "node dist/db/migrate.js",
    "start": "node dist/index.js",
    "build": "rimraf dist && npx tsc",
    "dev": "npx tsx watch src/index.ts",
    "db:migrate:dev": "npx tsx src/db/migrate.ts",
    "db-init": "npm run db:migrate:dev && npm run db:seed:dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "pg": "^8.21.0",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
