{
  "name": "trellis",
  "version": "0.1.0",
  "private": true,
  "description": "Trellis",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "node dist/db/migrate.js",
    "db:migrate:dev": "tsx src/db/migrate.ts",
    "db:seed:dev": "tsx src/db/seed.ts",
    "seed:graph": "tsx src/db/seed-graph.ts",
    "db-init": "npm run db:migrate:dev && npm run db:seed:dev",
    "reset-link": "tsx src/db/reset-link.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@openrouter/sdk": "^1.5.11",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.4",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "neo4j-driver": "^6.3.0",
    "pg": "^8.21.0",
    "tsx": "^4.22.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
