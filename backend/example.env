# Copy to backend/.env for local development. Every variable is explained in
# docs/backend-design.md §8 "Config". The server refuses to start without JWT_SECRET
# (32+ characters) and DB_URL.

# Read by the dev Postgres container too (docker-compose.dev.yml).
POSTGRES_USER=trellis
POSTGRES_PASSWORD=secret123
POSTGRES_DB=trellisdb

NODE_ENV=development
PORT=8000
# Where the site lives, as the browser sees it. Reset links are built from it.
PUBLIC_URL=http://localhost:3000
# 5050: docker-compose.dev.yml maps the dev Postgres to this port.
DB_URL=postgresql://trellis:secret123@localhost:5050/trellisdb

# Make your own: `openssl rand -hex 32`. Never reuse the production one.
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=60

# Sign in with Google: an OAuth client from Google Cloud Console (free), with the redirect
# URI http://localhost:3000/api/auth/google/callback. Leave empty to keep it off; then set
# NEXT_PUBLIC_GOOGLE_SIGNIN=on in frontend/.env once these are filled in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Neo4j (the topic graph). The dev password matches NEO4J_AUTH in docker-compose.dev.yml.
# The API starts without it; only the graph routes need it.
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=trellis-dev-pass

# The helper's AI (milestone M5). "off": the rule-based reader reads every message and no
# AWS is needed. "bedrock": GLM 5 on Amazon Bedrock, with credentials from the `trellis`
# AWS profile (never put AWS keys here).
AI_PROVIDER=off
# Only with AI_PROVIDER=bedrock on a laptop: the AWS CLI profile the SDK signs in with
# (`aws login --profile trellis` first). On the server the instance role is used instead.
# AWS_PROFILE=trellis
BEDROCK_REGION=ap-southeast-2
READER_MODEL=zai.glm-5
READER_PRICE_IN_PER_M=1.03
READER_PRICE_OUT_PER_M=3.30
AI_TIMEOUT_MS=6000
# Spending limits, in dollars (docs/backend-design.md §5 "Cost limits"). At a limit the
# rule-based reader takes over; nothing is refused.
# The whole site, per day. This is what caps the bill: 0.50 a day is at most $15 a month.
AI_DAILY_BUDGET_USD=0.50
# One account, per day and per week (Monday to Monday), across all its subjects. A
# message costs about $0.002, so these are roughly 30 a day and 125 a week.
AI_USER_DAILY_USD=0.06
AI_USER_WEEKLY_USD=0.25
# Typed messages one account may send in a day, whoever reads them. Not a money limit:
# it stops a script filling the chat table.
HELPER_DAILY_MESSAGES=100
